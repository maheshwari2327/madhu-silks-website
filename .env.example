# ==============================================================================
# MADHU SILKS E-COMMERCE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env in your root directory and fill in actual credentials.
# NEVER commit the actual .env file with secrets into version control.

# --- Django Application Settings ---
DJANGO_SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database & Cache ---
# PostgreSQL connection string: postgres://user:password@localhost:5432/madhu_silks_db
# Leave empty to default to local development SQLite (db.sqlite3)
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/1

# --- URLs & CORS ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Payment Gateway (Razorpay) ---
# Sign up at https://dashboard.razorpay.com to get your test credentials
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# --- Image CDN (Cloudinary) ---
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Shipping & Logistics (Shiprocket) ---
# Sign up at https://shiprocket.in
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# --- Monitoring & Error Tracking ---
SENTRY_DSN=
